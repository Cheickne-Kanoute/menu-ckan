{
  "redirects": [
    {
      "source": "/index",
      "destination": "/404",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/404",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/a-propos",
      "destination": "/a-propos.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/menu",
      "destination": "/menu.html"
    },
    {
      "source": "/reservation",
      "destination": "/reservation.html"
    }
  ],
  "trailingSlash": false,
  "cleanUrls": true
}